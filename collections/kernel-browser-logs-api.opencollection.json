{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kernel API Keys Browser Logs API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Browser Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Stream log files on the browser instance via SSE",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.onkernel.com/browsers/:id/logs/stream",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Browser session ID"
              },
              {
                "name": "source",
                "value": "",
                "type": "query"
              },
              {
                "name": "follow",
                "value": "",
                "type": "query"
              },
              {
                "name": "path",
                "value": "",
                "type": "query",
                "description": "only required if source is path"
              },
              {
                "name": "supervisor_process",
                "value": "",
                "type": "query",
                "description": "only required if source is supervisor"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Stream log files on the browser instance via SSE"
        }
      ]
    }
  ],
  "bundled": true
}