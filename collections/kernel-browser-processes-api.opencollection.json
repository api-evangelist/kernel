{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kernel API Keys Browser Processes API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Browser Processes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Execute a command synchronously",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.onkernel.com/browsers/:id/process/exec",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Browser session ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Execute a command synchronously"
        },
        {
          "info": {
            "name": "Execute a command asynchronously",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.onkernel.com/browsers/:id/process/spawn",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Browser session ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Execute a command asynchronously"
        },
        {
