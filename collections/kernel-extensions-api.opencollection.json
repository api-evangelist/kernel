{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kernel API Keys Extensions API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Extensions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List browser extensions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.onkernel.com/extensions",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit the number of extensions to return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Offset the number of extensions to return."
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Case-insensitive substring match against extension name. IDs match by exact value."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Exact-match filter on extension name using the database collation. In production, matching is case- and accent-insensitive. During the default-project migration, unscoped requests prefer a concrete default-project extension over a legacy unscoped extension with the same name."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List extensions in the resolved project."
        },
        {
          "info": {
            "name": "Upload a browser extension",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.onkernel.com/extensions",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "name",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Upload a zip file containing an unpacked browser extension. Optionally provide a unique name for later reference."
        },
        {
          "info": {
            "name": "Download extension archive",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.onkernel.com/extensions/:id_or_name",
            "params": [
              {
                "name": "id_or_name",
                "value": "",
                "type": "path",
                "description": "Extension ID or name"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Download the extension as a ZIP archive by ID or name."
        },
        {
          "info": {
            "name": "Delete extension by ID or name",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.onkernel.com/extensions/:id_or_name",
            "params": [
              {
                "name": "id_or_name",
                "value": "",
                "type": "path",
                "description": "Extension ID or extension name"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete an extension by its ID or by its name."
        },
        {
          "info": {
            "name": "Get extension metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.onkernel.com/extensions/:id_or_name/metadata",
            "params": [
              {
                "name": "id_or_name",
                "value": "",
                "type": "path",
                "description": "Extension ID or name"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get an extension's metadata (name, size, timestamps) by ID or name, without downloading the archive."
        },
        {
          "info": {
            "name": "Download unpacked extension from Chrome Web Store",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.onkernel.com/extensions/from_chrome_store",
            "params": [
              {
                "name": "url",
                "value": "",
                "type": "query",
                "description": "Chrome Web Store URL for the extension."
              },
              {
                "name": "os",
                "value": "",
                "type": "query",
                "description": "Target operating system for the extension package. Defaults to linux."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a ZIP archive containing the unpacked extension fetched from the Chrome Web Store."
        }
      ]
    }
  ],
  "bundled": true
}