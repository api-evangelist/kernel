{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kernel API Keys Credential Providers API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Credential Providers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List credential providers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.onkernel.com/org/credential_providers",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit the number of credential providers to return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Offset the number of credential providers to return."
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Case-insensitive substring match against credential provider name. IDs match by exact value."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List external credential providers configured for the organization."
        },
        {
          "info": {
            "name": "Create a credential provider",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.onkernel.com/org/credential_providers",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Configure an external credential provider (e.g., 1Password) for automatic credential lookup."
        },
        {
          "info": {
            "name": "Get credential provider by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.onkernel.com/org/credential_providers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Credential provider ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a credential provider by its ID."
        },
        {
          "info": {
            "name": "Update credential provider",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.onkernel.com/org/credential_providers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Credential provider ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a credential provider's configuration."
        },
        {
          "info": {
            "name": "Delete credential provider",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.onkernel.com/org/credential_providers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Credential provider ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a credential provider by its ID."
        },
        {
          "info": {
            "name": "Test credential provider connection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.onkernel.com/org/credential_providers/:id/test",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Credential provider ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Validate the credential provider's token and list accessible vaults."
        },
        {
          "info": {
            "name": "List items from a credential provider",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.onkernel.com/org/credential_providers/:id/items",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Credential provider ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns available credential items (e.g., 1Password login items) from the provider."
        }
      ]
    }
  ],
  "bundled": true
}